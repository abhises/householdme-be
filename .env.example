# ---- Database (docker compose up -d) ----
DATABASE_URL="postgresql://householdme:householdme@localhost:5436/householdme?schema=public"

# ---- Admin auth ----
# Used to sign the admin session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@householdme.com"
ADMIN_PASSWORD="admin12345"

# ---- Server ----
PORT=4100
# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGIN="http://localhost:3100"
# Public URL of this API, used to build absolute URLs for locally stored uploads
PUBLIC_API_URL="http://localhost:4100"

# ---- File storage ----
# "local" stores uploads on disk in LOCAL_UPLOAD_DIR and serves them from /uploads/* on this API
# "s3" stores uploads in an S3 (or S3-compatible: R2, MinIO, Spaces) bucket
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./storage/uploads"

# S3 settings (only used when STORAGE_DRIVER="s3")
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint for S3-compatible providers (MinIO, R2, ...)
S3_ENDPOINT=""
# Optional: set "true" for MinIO and other path-style providers
S3_FORCE_PATH_STYLE="false"
# Optional: public base URL for objects (CDN / CloudFront). Defaults to the bucket URL.
S3_PUBLIC_URL=""
