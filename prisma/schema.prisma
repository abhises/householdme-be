// HouseholdMe content model.
// Nested, list-shaped content (FAQ, changelog, comparison tables, ...) is kept in
// Json columns; their shapes are documented in src/types/content.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Admin")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  intro     String   @default("")
  sortOrder Int      @default(0)
  guides    Guide[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String   @default("")
  short       String   @default("")
  bio         String   @default("")
  /// Sentence used in "Why you can trust us" on guides
  trust       String   @default("")
  imageUrl    String?
  /// Social profile links shown on the author page and guide author box
  linkedinUrl String?
  youtubeUrl  String?
  /// [{ value, label }]
  facts       Json     @default("[]")
  expertise   String[] @default([])
  /// [{ year, text }]
  career      Json     @default("[]")
  /// Shown on the editorial team pages
  onTeam      Boolean  @default(true)
  /// Shown in "Our testers" on the home page
  isTester    Boolean  @default(true)
  sortOrder   Int      @default(0)
  guides      Guide[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// What kind of post a Guide row is (chosen when adding a new post)
enum PostType {
  BUYING_GUIDE
  SINGLE_REVIEW
  COMPARISON
  INFO_ARTICLE
}

model Guide {
  id              String    @id @default(cuid())
  slug            String    @unique
  type            PostType  @default(BUYING_GUIDE)
  title           String
  seoTitle        String?
  short           String
  intro           String    @default("")
  published       Boolean   @default(true)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId        String
  author          Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  modelsTested    Int       @default(0)
  testWeeks       Int       @default(0)
  updatedLabel    String    @default("")
  publishedLabel  String    @default("")
  photoNote       String    @default("")
  coverImage      String?
  heroImage       String?
  testImage       String?
  forWho          String    @default("")
  howTested       String    @default("")
  howCaption      String?
  bought          String?
  /// Score criteria, e.g. ["Suction", "Battery", ...]
  criteria        String[]  @default([])
  /// Test results table: header row and body rows
  tableHead       Json?
  tableRows       Json?
  tableNote       String?
  /// [{ q, a }]
  faq             Json      @default("[]")
  sources         String[]  @default([])
  /// [{ date, text }]
  changes         Json      @default("[]")
  /// Long-form sections (summary, compare table, deep dives, ...). See GuideFull type.
  full            Json?
  sortOrder       Int       @default(0)
  /// Meta description; falls back to the intro
  seoDescription  String?
  /// Raw JSON-LD (structured data) for this page. Section/HTML posts only.
  jsonLd          String?
  /// The page body for section/HTML posts, rendered as-is. Empty = the classic guide template is used.
  html            String    @default("")
  /// Extra CSS for this post only
  css             String    @default("")
  /// Section-based content: { layout: "toc" | "wide" | "raw", items: [{ id, type, data, hidden? }] }.
  /// When set, `html` is rendered from it on save; when null the post is plain HTML (or the classic template).
  sections        Json?
  /// Sticky "our pick" bar shown while scrolling: { name, score, price, shop, url, image }
  stickyBar       Json?
  /// Show the newsletter popup on this post
  newsletterPopup Boolean   @default(false)
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Reusable content blocks for section-based posts (built-in types are synced from code on startup)
model SectionType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  group       String   @default("Other")
  description String   @default("")
  /// [{ key, label, type, required?, help?, options?, fields? }]
  fields      Json     @default("[]")
  /// HTML with {{placeholders}}, {{#list}}…{{/list}} and {{^empty}}…{{/empty}}
  template    String   @default("")
  /// CSS for custom types; scoped to the section automatically. Built-in types use sections.css.
  css         String   @default("")
  /// Sample field values for previews
  sample      Json     @default("{}")
  /// Table-of-contents label, a template like "{{heading}}"; empty = not in the TOC
  tocLabel    String   @default("")
  /// "body" (main column), "top" (full width above the columns) or "bottom" (full width below)
  placement   String   @default("body")
  /// "any", "post" or "home"
  scope       String   @default("any")
  builtIn     Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  guideId      String
  guide        Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  /// 0 = our pick, 1 = budget pick, 2 = upgrade
  rank         Int      @default(0)
  label        String   @default("Our pick")
  score        Float    @default(0)
  price        Int      @default(0)
  verdict      String   @default("")
  pros         String[] @default([])
  cons         String[] @default([])
  images       String[] @default([])
  subtitle     String?
  verdictLong  String?
  inUseSince   String?
  purchase     String?
  readTime     String?
  designText   String?
  videoUrl     String?
  goodFor      String[] @default([])
  notFor       String[] @default([])
  sources      String[] @default([])
  /// [{ label, value }]
  subScores    Json     @default("[]")
  /// [{ shop, price, url, note }]
  shops        Json     @default("[]")
  /// [{ month, price }]
  priceHistory Json     @default("[]")
  /// [{ label, value, average, pct, averagePct }]
  results      Json     @default("[]")
  /// [{ date, text }]
  longTerm     Json     @default("[]")
  /// [{ k, v }]
  specs        Json     @default("[]")
  /// [{ name, cells: string[] }]
  compareRows  Json     @default("[]")
  /// [{ who, q, a }]
  questions    Json     @default("[]")
  /// [{ q, a }]
  faq          Json     @default("[]")
  /// [{ date, text }]
  changes      Json     @default("[]")
  helpfulYes   Int      @default(0)
  helpfulNo    Int      @default(0)
  deals        Deal[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guideId, rank])
}

model Deal {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wasPrice  Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InfoPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  lead      String   @default("")
  /// [{ heading, body }]
  sections  Json     @default("[]")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  driver    String
  filename  String
  mimeType  String
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())
}

/// Key/value site configuration (home page hero, trust facts, test method, ...)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A local cleaning business that can be given a HouseholdMe award
model CleaningService {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  city              String
  /// Two-letter state code, e.g. "OR"
  state             String
  address           String   @default("")
  phone             String   @default("")
  /// Contact email (used later for award notification emails)
  email             String   @default("")
  website           String?
  logoUrl           String?
  googleRating      Float?
  googleReviews     Int?
  yelpRating        Float?
  yelpReviews       Int?
  /// e.g. ["Recurring cleaning", "Deep cleaning", "Move-in / move-out"]
  services          String[] @default([])
  licensed          Boolean  @default(false)
  insured           Boolean  @default(false)
  backgroundChecked Boolean  @default(false)
  /// Internal research notes, never shown on the site
  notes             String   @default("")
  awards            Award[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([state, city])
}

/// One award given to a cleaning service for a city and year, e.g. "Best overall" in Bend, OR, 2026
model Award {
  id         String          @id @default(cuid())
  serviceId  String
  service    CleaningService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  year       Int
  /// City and state of the award page (usually the business's own city)
  city       String
  state      String
  /// e.g. "Best overall", "Best for move-out cleans", "Best value"
  title      String
  /// Position on the city page, 1 = first
  rank       Int             @default(1)
  /// Our score out of 10
  score      Float?
  whyItWon   String          @default("")
  published  Boolean         @default(true)
  /// When the business was emailed about the award (not sent yet = null)
  notifiedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([serviceId, year, state, city])
  @@index([year, state, city, rank])
}
